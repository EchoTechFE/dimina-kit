{
  "extends": "@dimina-kit/typescript-config/base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // `src/simulator-ui` is browser code for a bundler, not Node16 main-process
  // ESM — it type-checks through tsconfig.simulator-ui.json instead.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/simulator-ui"]
}
