<view class="wrap">
  <canvas canvas-id="mainCanvas" class="main-canvas"></canvas>

  <button class="btn" data-action="basic-rect" bindtap="onBasicRect">basic-rect</button>
  <button class="btn" data-action="reserve-batch-a" bindtap="onReserveBatchA">reserve-batch-a</button>
  <button class="btn" data-action="reserve-batch-b-reset" bindtap="onReserveBatchBReset">reserve-batch-b-reset</button>
  <button class="btn" data-action="reserve-batch-c-keep" bindtap="onReserveBatchCKeep">reserve-batch-c-keep</button>
  <button class="btn" data-action="gradient" bindtap="onGradient">gradient</button>
  <button class="btn" data-action="measure-fonts" bindtap="onMeasureFonts">measure-fonts</button>
  <button class="btn" data-action="font-accept-weight-style" bindtap="onFontAcceptWeightStyle">font-accept-weight-style</button>
  <button class="btn" data-action="font-accept-single-modifier" bindtap="onFontAcceptSingleModifier">font-accept-single-modifier</button>
  <button class="btn" data-action="serial-draw" bindtap="onSerialDraw">serial-draw</button>
  <button class="btn" data-action="path-snapshot-transform" bindtap="onPathSnapshotTransform">path-snapshot-transform</button>
  <button class="btn" data-action="save-restore" bindtap="onSaveRestore">save-restore</button>
  <button class="btn" data-action="pixel-round-trip" bindtap="onPixelRoundTrip">pixel-round-trip</button>
  <button class="btn" data-action="clip-lock-batch-a" bindtap="onClipLockBatchA">clip-lock-batch-a</button>
  <button class="btn" data-action="clip-lock-batch-b-no-clip" bindtap="onClipLockBatchBNoClip">clip-lock-batch-b-no-clip</button>
  <button class="btn" data-action="unbalanced-restore-batch-a" bindtap="onUnbalancedRestoreBatchA">unbalanced-restore-batch-a</button>
  <button class="btn" data-action="unbalanced-restore-batch-b-clean" bindtap="onUnbalancedRestoreBatchBClean">unbalanced-restore-batch-b-clean</button>
</view>
