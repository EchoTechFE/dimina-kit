{
  "name": "@dimina-kit/design",
  "version": "0.1.0",
  "description": "Design tokens, base styles, Tailwind preset and the electron-deck dock skin shared by dimina-kit's Electron UIs.",
  "keywords": [
    "dimina",
    "devtools",
    "design-tokens",
    "tailwind",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "EchoTechFE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTechFE/dimina-kit.git",
    "directory": "packages/design"
  },
  "bugs": {
    "url": "https://github.com/EchoTechFE/dimina-kit/issues"
  },
  "homepage": "https://github.com/EchoTechFE/dimina-kit/tree/main/packages/design#readme",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css/*": "./css/*",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "css",
    "tailwind-preset.cjs",
    "README.md",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=test-report.json --coverage.enabled --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "test:dev": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@dimina-kit/eslint-config": "workspace:*",
    "@dimina-kit/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./css/*": "./css/*",
      "./tailwind-preset": "./tailwind-preset.cjs",
      "./package.json": "./package.json"
    }
  }
}
