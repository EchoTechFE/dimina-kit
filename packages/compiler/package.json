{
  "name": "@dimina-kit/compiler",
  "version": "0.0.2",
  "description": "dmcc compiler bundles (browser + node) that drive @dimina/compiler against a caller-injected node:fs replacement (no bundled fs)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTechFE/dimina-kit.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/EchoTechFE/dimina-kit/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/EchoTechFE/dimina-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/compile-core.node.js",
  "exports": {
    ".": {
      "types": "./dist/types/compile-core.d.ts",
      "default": "./dist/compile-core.node.js"
    },
    "./browser": {
      "types": "./dist/types/browser-entry.d.ts",
      "default": "./dist/compile-core.browser.js"
    },
    "./pool-node": {
      "types": "./dist/types/pool-node.d.ts",
      "default": "./dist/pool.node.js"
    },
    "./pool": {
      "types": "./dist/types/pool.d.ts",
      "default": "./dist/pool.browser.js"
    },
    "./stage-worker": {
      "types": "./dist/types/stage-worker.d.ts",
      "default": "./dist/stage-worker.browser.js"
    },
    "./toolchain": {
      "types": "./dist/types/toolchain.d.ts",
      "default": "./dist/toolchain.browser.js"
    },
    "./browser-assets": {
      "types": "./dist/types/browser-assets.d.ts",
      "require": "./dist/browser-assets.cjs",
      "default": "./dist/browser-assets.js"
    },
    "./file-types": {
      "types": "./dist/types/file-types.d.ts",
      "require": "./dist/file-types.cjs",
      "default": "./dist/file-types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "!scripts/test-*.js"
  ],
  "scripts": {
    "check:wasm-alignment": "node scripts/check-wasm-alignment.js",
    "snapshot:upstream-versions": "node scripts/snapshot-upstream-versions.js",
    "build:node": "node scripts/build-compiler.js node",
    "build:browser": "node scripts/build-compiler.js browser",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "pnpm run build:node && pnpm run build:browser && pnpm run build:types",
    "check-types": "pnpm run build:types && node scripts/test-types.js",
    "test:node": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-node.js",
    "test:appid": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-appid-fallback.js",
    "test:hardening": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-hardening.js",
    "test:decompose": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-decompose.js",
    "test:realm-reuse": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-realm-reuse.js",
    "test:pool-node": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-pool-node.js",
    "test:pool-scopehash": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-pool-scopehash.js",
    "test": "pnpm run test:browser-assets && pnpm run test:error-codes && pnpm run test:binary-seed && pnpm run test:binary-outputs:prebuilt && pnpm run test:file-types && pnpm run test:pool-filetypes:prebuilt",
    "test:file-types": "node scripts/test-file-types.js",
    "test:binary-seed": "node scripts/test-binary-seed.js",
    "test:binary-outputs": "node scripts/build-compiler.js node && node scripts/build-compiler.js browser && pnpm run test:binary-outputs:prebuilt",
    "test:binary-outputs:prebuilt": "node --import ./scripts/register-kit.js scripts/test-binary-outputs.js",
    "test:error-codes": "node scripts/test-error-codes.js",
    "test:browser-assets": "node scripts/test-browser-assets.js",
    "test:crypto-shim": "node scripts/test-crypto-shim.js",
    "test:pool-hardening": "node scripts/build-compiler.js node && node scripts/test-pool-hardening.js",
    "test:pool-toolchain-death": "node scripts/build-compiler.js node && node scripts/test-pool-toolchain-death.js",
    "test:pool-worker-hardening": "node scripts/test-pool-worker-hardening.js",
    "test:worker-slot": "node scripts/test-worker-slot.js",
    "test:pool-watchdog": "node scripts/test-pool-watchdog.js",
    "test:lazy-toolchain": "node scripts/build-compiler.js node && node scripts/test-lazy-toolchain.js",
    "test:idle-shrink": "node scripts/build-compiler.js node && node scripts/test-idle-shrink.js",
    "test:warm-default": "node scripts/build-compiler.js node && node scripts/test-warm-default.js",
    "test:npm-scan": "node scripts/build-compiler.js node && node --import ./scripts/register-kit.js scripts/test-npm-scan.js",
    "test:stage-toolchain": "node scripts/build-compiler.js browser && node scripts/test-stage-toolchain.js",
    "test:stage-worker-message-order": "node scripts/build-compiler.js node && node scripts/test-stage-worker-message-order.js",
    "test:stage-load-retry": "node scripts/build-compiler.js node && node scripts/test-stage-load-retry.js",
    "test:pool-filetypes": "node scripts/build-compiler.js node && node scripts/build-compiler.js browser && pnpm run test:pool-filetypes:prebuilt",
    "test:pool-filetypes:prebuilt": "node scripts/test-pool-filetypes.js"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@vue/compiler-sfc": "^3.5.41",
    "assert": "^2.1.0",
    "autoprefixer": "^10.5.3",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "cssnano": "8.0.6",
    "esbuild": "^0.28.1",
    "estree-walker": "^3.0.3",
    "events": "^3.3.0",
    "htmlparser2": "^12.0.0",
    "less": "^4.9.0",
    "magic-string": "1.2.3",
    "memfs": "^4.57.8",
    "oxc-parser": "^0.145.0",
    "oxc-walker": "^1.1.1",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "sass": "1.102.0",
    "source-map-js": "^1.2.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "peerDependencies": {
    "@oxc-parser/binding-wasm32-wasi": "^0.145.0",
    "esbuild-wasm": "^0.28.1"
  },
  "peerDependenciesMeta": {
    "@oxc-parser/binding-wasm32-wasi": {
      "optional": true
    },
    "esbuild-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild-wasm": "^0.28.1",
    "typescript": "5.9.2"
  }
}
