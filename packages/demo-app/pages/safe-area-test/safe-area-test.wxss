.safe-area-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.probe-box {
  border: 2rpx dashed #bbb;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.probe {
  background: #ff7875;
}

/* 探针尺寸直接来自 env()，量它就是量 env() */
.probe-top {
  height: env(safe-area-inset-top);
}

.probe-bottom {
  height: env(safe-area-inset-bottom);
  background: #40a9ff;
}

.probe-middle {
  display: flex;
  align-items: stretch;
  min-height: 120rpx;
}

.probe-left {
  width: env(safe-area-inset-left);
  background: #95de64;
}

.probe-right {
  width: env(safe-area-inset-right);
  background: #ffc53d;
}

.probe-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.probe-hint {
  font-size: 24rpx;
  color: #999;
}

.desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin: 12rpx 0 20rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #1f2937;
}

.bottom-bar-text {
  font-size: 24rpx;
  color: #fff;
  line-height: 1.5;
}
