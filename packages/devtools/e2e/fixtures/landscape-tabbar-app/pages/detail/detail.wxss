.page-detail {
  color: #096dd9;
}

/* Makes the four CSS `env(safe-area-inset-*)` values readable through
   getComputedStyle, so a test can compare them against the `safeArea` this
   same page's `wx.getSystemInfoSync()` reports. */
.probe-env {
  padding-top: env(safe-area-inset-top, 0px);
  padding-right: env(safe-area-inset-right, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  padding-left: env(safe-area-inset-left, 0px);
}
